class Solution {
public:
    uint32_t reverseBits(uint32_t n) {
        uint32_t res = 0;
        for (int i = 0; i < 32; i++) {
            // Shift result left to make room for the next bit
            res = (res << 1) | (n & 1);
            // Shift n right to process the next bit
            n >>= 1;
        }
        return res;
    }
};
