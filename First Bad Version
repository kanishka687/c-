// The API isBadVersion is defined for you.
// bool isBadVersion(int version);

class Solution {
public:
    int firstBadVersion(int n) {
        int left = 1;
        int right = n;
        
        while (left < right) {
            // Prevent overflow by using this instead of (left + right) / 2
            int mid = left + (right - left) / 2;
            
            if (isBadVersion(mid)) {
                // This could be the first bad one, 
                // so look at it or earlier
                right = mid;
            } else {
                // Definitely not bad, start searching after mid
                left = mid + 1;
            }
        }
        
        // left and right meet at the first bad version
        return left;
    }
};
