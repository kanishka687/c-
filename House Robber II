#include <vector>
#include <algorithm>

class Solution {
public:
    int rob(std::vector<int>& nums) {
        int n = nums.size();
        
        // Edge cases for small number of houses
        if (n == 0) return 0;
        if (n == 1) return nums[0];
        if (n == 2) return std::max(nums[0], nums[1]);

        // Scenario 1: Exclude the last house; Scenario 2: Exclude the first house
        return std::max(robLinear(nums, 0, n - 2), 
                        robLinear(nums, 1, n - 1));
    }

private:
    // Standard House Robber logic for a linear street
    int robLinear(const std::vector<int>& nums, int start, int end) {
        int prev2 = 0; // max money robbed 2 houses ago
        int prev1 = 0; // max money robbed 1 house ago
        
        for (int i = start; i <= end; i++) {
            // Decision: Rob current house (nums[i] + prev2) OR skip it (prev1)
            int current = std::max(nums[i] + prev2, prev1);
            prev2 = prev1;
            prev1 = current;
        }
        
        return prev1;
    }
};
