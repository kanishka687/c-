class Solution {
public:
    void deleteNode(ListNode* node) {
        // Copy the value of the next node into the current node
        node->val = node->next->val;
        
        // Save the node to be deleted to free memory (optional but good practice)
        ListNode* temp = node->next;
        
        // Point current node to the one after the next
        node->next = node->next->next;
        
        // Explicitly delete the bypassed node (if not using managed memory)
        // delete temp; 
    }
};
