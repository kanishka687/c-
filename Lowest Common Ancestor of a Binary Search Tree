class Solution {
public:
    TreeNode* lowestCommonAncestor(TreeNode* root, TreeNode* p, TreeNode* q) {
        while (root) {
            if (p->val < root->val && q->val < root->val) {
                // Move to left subtree
                root = root->left;
            } else if (p->val > root->val && q->val > root->val) {
                // Move to right subtree
                root = root->right;
            } else {
                // We found the split point
                return root;
            }
        }
        return nullptr;
    }
};
