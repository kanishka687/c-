class Solution {
    unordered_map<string, int> dist;
    vector<vector<string>> result;
    string bWord;

public:
    vector<vector<string>> findLadders(string beginWord, string endWord, vector<string>& wordList) {
        unordered_set<string> st(wordList.begin(), wordList.end());
        if (st.find(endWord) == st.end()) return {};

        bWord = beginWord;
        queue<string> q;
        q.push(beginWord);
        dist[beginWord] = 0;

        // Step 1: BFS to find shortest distances
        while (!q.empty()) {
            string curr = q.front();
            q.pop();

            if (curr == endWord) break;

            string temp = curr;
            for (int i = 0; i < temp.size(); i++) {
                char original = temp[i];
                for (char c = 'a'; c <= 'z'; c++) {
                    temp[i] = c;
                    if (st.count(temp) && dist.find(temp) == dist.end()) {
                        dist[temp] = dist[curr] + 1;
                        q.push(temp);
                    }
                }
                temp[i] = original;
            }
        }

        // Step 2: DFS to backtrack and find all paths
        if (dist.count(endWord)) {
            vector<string> path = {endWord};
            backtrack(endWord, path);
        }
        return result;
    }

private:
    void backtrack(string curr, vector<string>& path) {
        if (curr == bWord) {
            vector<string> validPath = path;
            reverse(validPath.begin(), validPath.end());
            result.push_back(validPath);
            return;
        }

        int currentDist = dist[curr];
        string temp = curr;
        for (int i = 0; i < temp.size(); i++) {
            char original = temp[i];
            for (char c = 'a'; c <= 'z'; c++) {
                temp[i] = c;
                // Only move to a neighbor that is exactly 1 step closer to beginWord
                if (dist.count(temp) && dist[temp] == currentDist - 1) {
                    path.push_back(temp);
                    backtrack(temp, path);
                    path.pop_back();
                }
            }
            temp[i] = original;
        }
    }
};
