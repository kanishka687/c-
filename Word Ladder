class Solution {
public:
    int ladderLength(string beginWord, string endWord, vector<string>& wordList) {
        unordered_set<string> wordSet(wordList.begin(), wordList.end());
        
        // If endWord isn't in the list, no transformation is possible
        if (wordSet.find(endWord) == wordSet.end()) return 0;

        queue<pair<string, int>> q;
        q.push({beginWord, 1});

        while (!q.empty()) {
            string word = q.front().first;
            int steps = q.front().second;
            q.pop();

            // Try changing every character of the word
            for (int i = 0; i < word.length(); i++) {
                char originalChar = word[i];
                
                for (char c = 'a'; c <= 'z'; c++) {
                    word[i] = c;

                    if (word == endWord) return steps + 1;

                    // If the new word is in the dictionary, add to queue
                    if (wordSet.count(word)) {
                        wordSet.erase(word); // Mark as visited
                        q.push({word, steps + 1});
                    }
                }
                // Restore the word for the next character position
                word[i] = originalChar;
            }
        }

        return 0;
    }
};
