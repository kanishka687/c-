#include <iostream>
#include <string>
#include <vector>
#include <sstream>
#include <algorithm>

class Solution {
public:
    string reverseWords(string s) {
        stringstream ss(s);
        string word;
        vector<string> words;

        // Extract words using stringstream (skips extra spaces)
        while (ss >> word) {
            words.push_back(word);
        }

        // Reverse the vector
        reverse(words.begin(), words.end());

        // Join words with a single space
        string res = "";
        for (int i = 0; i < words.size(); i++) {
            res += words[i];
            if (i < words.size() - 1) res += " ";
        }
        return res;
    }
};
