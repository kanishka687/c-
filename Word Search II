#include <vector>
#include <string>

struct TrieNode {
    TrieNode* children[26] = {nullptr};
    string* word = nullptr; // Store the full word at the leaf node
};

class Solution {
    void insert(TrieNode* root, string& w) {
        TrieNode* curr = root;
        for (char c : w) {
            int i = c - 'a';
            if (!curr->children[i]) curr->children[i] = new TrieNode();
            curr = curr->children[i];
        }
        curr->word = &w; 
    }

    void dfs(vector<vector<char>>& board, int r, int c, TrieNode* node, vector<string>& result) {
        char letter = board[r][c];
        TrieNode* nextNode = node->children[letter - 'a'];

        if (!nextNode) return;

        // Found a word!
        if (nextNode->word) {
            result.push_back(*nextNode->word);
            nextNode->word = nullptr; // Optimization: remove word from Trie so we don't find it again
        }

        // Mark as visited
        board[r][c] = '#';

        int dr[] = {-1, 1, 0, 0};
        int dc[] = {0, 0, -1, 1};

        for (int i = 0; i < 4; i++) {
            int nr = r + dr[i], nc = c + dc[i];
            if (nr >= 0 && nr < board.size() && nc >= 0 && nc < board[0].size() && board[nr][nc] != '#') {
                dfs(board, nr, nc, nextNode, result);
            }
        }

        // Backtrack: restore character
        board[r][c] = letter;
    }

public:
    vector<string> findWords(vector<vector<char>>& board, vector<string>& words) {
        TrieNode* root = new TrieNode();
        for (string& w : words) insert(root, w);

        vector<string> result;
        int m = board.size(), n = board[0].size();

        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {
                dfs(board, i, j, root, result);
            }
        }

        return result;
    }
};
