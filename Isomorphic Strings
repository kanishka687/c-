#include <string>
#include <vector>

class Solution {
public:
    bool isIsomorphic(std::string s, std::string t) {
        // Use arrays of size 256 for all possible ASCII characters
        // Initialized to 0 (indicating the character hasn't been seen yet)
        int mapS[256] = {0};
        int mapT[256] = {0};
        
        int n = s.length();
        for (int i = 0; i < n; i++) {
            // If the last seen positions don't match, they aren't isomorphic
            if (mapS[(unsigned char)s[i]] != mapT[(unsigned char)t[i]]) {
                return false;
            }
            
            // Update the last seen position to the current index + 1
            // We use i + 1 because the array is initialized with 0
            mapS[(unsigned char)s[i]] = i + 1;
            mapT[(unsigned char)t[i]] = i + 1;
        }
        
        return true;
    }
};
