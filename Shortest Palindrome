#include <string>
#include <vector>
#include <algorithm>

class Solution {
public:
    string shortestPalindrome(string s) {
        if (s.empty()) return s;

        string rev_s = s;
        reverse(rev_s.begin(), rev_s.end());

        // Create the combined string for KMP
        // The '#' prevents the prefix and reversed suffix from overlapping
        string temp = s + "#" + rev_s;
        int n = temp.length();
        
        // Build LPS (Longest Prefix Suffix) array
        vector<int> lps(n, 0);
        for (int i = 1; i < n; i++) {
            int j = lps[i - 1];
            while (j > 0 && temp[i] != temp[j]) {
                j = lps[j - 1];
            }
            if (temp[i] == temp[j]) {
                j++;
            }
            lps[i] = j;
        }

        // lps.back() is the length of the longest palindromic prefix
        int longest_pal_prefix_len = lps.back();
        
        // Take the part of s that ISN'T in the prefix, reverse it, and add to front
        string suffix_to_add = s.substr(longest_pal_prefix_len);
        reverse(suffix_to_add.begin(), suffix_to_add.end());
        
        return suffix_to_add + s;
    }
};
