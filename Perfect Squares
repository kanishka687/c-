class Solution {
public:
    int numSquares(int n) {
        // Check if n is a perfect square
        if (isSquare(n)) return 1;

        // Check if result is 4: n = 4^k * (8m + 7)
        while (n % 4 == 0) n /= 4;
        if (n % 8 == 7) return 4;

        // Check if result is 2: n = a^2 + b^2
        for (int i = 1; i * i <= n; i++) {
            if (isSquare(n - i * i)) return 2;
        }

        return 3;
    }

private:
    bool isSquare(int n) {
        int r = sqrt(n);
        return r * r == n;
    }
};
