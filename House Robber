#include <vector>
#include <algorithm>

class Solution {
public:
    int rob(std::vector<int>& nums) {
        int rob1 = 0; // Max profit 2 houses ago
        int rob2 = 0; // Max profit 1 house ago
        
        for (int n : nums) {
            int current_max = std::max(rob1 + n, rob2);
            rob1 = rob2;
            rob2 = current_max;
        }
        
        return rob2;
    }
};
