#include <vector>
#include <string>
#include <algorithm>

using namespace std;

class Solution {
public:
    string largestNumber(vector<int>& nums) {
        vector<string> str_nums;
        for (int num : nums) {
            str_nums.push_back(to_string(num));
        }

        // Sort strings based on combined results
        sort(str_nums.begin(), str_nums.end(), [](const string& a, const string& b) {
            return (a + b) > (b + a);
        });

        // Edge case: if the largest number is "0", the entire result is "0"
        if (str_nums[0] == "0") return "0";

        string result = "";
        for (const string& s : str_nums) {
            result += s;
        }

        return result;
    }
};
